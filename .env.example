# =====================================================================
# NutriMenu AI - Production Environment Configuration Template
# =====================================================================
# Copy this file to `.env` for local development or set these variables
# in your cloud hosting provider (Render, Railway, Fly.io, AWS, etc.).

# ---------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ---------------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=development

# Base URL of the frontend application (used for email links & verification redirects)
APP_URL=http://localhost:5173

# Comma-separated list of allowed frontend origins (CORS & CSRF origin validation)
# In production, specify exact HTTPS domains (wildcard '*' and regex are rejected in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Number of trusted reverse proxies in front of FastAPI (e.g., Render/Cloudflare = 1)
# Ensures accurate client IP extraction for sliding-window rate limiting & lockout
TRUSTED_PROXY_COUNT=1


# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Development fallback: sqlite:///./nutrimenu.db
# Production: Managed PostgreSQL (Neon, Supabase, AWS RDS, Render Postgres)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=sqlite:///./nutrimenu.db

# Database connection pool settings (for high concurrency)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true


# ---------------------------------------------------------------------
# 3. AUTHENTICATION, TOKENS & SESSIONS
# ---------------------------------------------------------------------
# Cryptographically strong secret key (minimum 32 characters in production)
# Generate via: openssl rand -base64 32
SECRET_KEY=replace-with-a-32-character-random-secret-key-for-jwt
BETTER_AUTH_SECRET=replace-with-a-32-character-random-secret-key-for-jwt

# Symmetric Fernet key for encrypting sensitive user credentials at rest (e.g. BYOK Gemini keys)
ENCRYPTION_SECRET_KEY=replace-with-a-32-character-random-encryption-key

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRY_MINUTES=10
DELETION_GRACE_DAYS=14

# Require email verification before issuing full login sessions
# Defaults to false in development for fast testing; enforced true in production
REQUIRE_EMAIL_VERIFICATION=false


# ---------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL DELIVERY (SMTP)
# ---------------------------------------------------------------------
# When SMTP_HOST is omitted in development, emails print to console & in-memory test sink.
# In production, configure your transactional email service (SendGrid, Postmark, AWS SES, Resend, Mailgun):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NutriMenu AI <no-reply@nutrimenu.ai>
SMTP_USE_TLS=true
SMTP_USE_SSL=false


# ---------------------------------------------------------------------
# 5. AI ENGINES (Gemini & OpenRouter Vision)
# ---------------------------------------------------------------------
# Google Gemini API Key (Primary Vision & Recommendation AI Engine)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (Default: gemini-2.5-flash or gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter / Vision AI API Key (Optional Fallback)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
