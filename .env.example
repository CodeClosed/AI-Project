# ==========================================
# NutriMenu AI - Environment Configuration Example
# ==========================================

# Google Gemini API Key (Primary Vision & Recommendation AI Engine)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (Default: gemini-3.7-flash)
# Supported options:
# - gemini-3.7-flash
# - gemini-2.5-flash
# - gemini-2.0-flash
# - gemini-1.5-flash
GEMINI_MODEL=gemini-3.7-flash

# OpenRouter / Vision AI API Key (Optional Fallback)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ==========================================
# Full-Stack Database & Better Auth Security Configuration
# ==========================================
# Database connection string (default: local SQLite database)
DATABASE_URL=sqlite:///./nutrimenu.db

# Better Auth Secret (Priority: BETTER_AUTH_SECRET > AUTH_SECRET > SECRET_KEY)
# In production, this must be a cryptographically strong 32+ character key.
# Generate via: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_minimum_random_secret_key_here
SECRET_KEY=your_32_character_minimum_random_secret_key_here

# Symmetric Encryption Key for sensitive fields (Gemini API keys at rest via Fernet AES)
ENCRYPTION_SECRET_KEY=nutrimenu-fernet-encryption-key-production-2026

# Access token lifespan in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Better Auth Trusted Origins / CORS Whitelist (comma-separated)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000


